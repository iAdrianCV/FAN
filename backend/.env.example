# --- Base de datos (MySQL 8+ / XAMPP MariaDB) ---
DATABASE_URL=mysql+aiomysql://root:@localhost:3306/lotepos?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Seguridad ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Aplicación ---
ENVIRONMENT=development
CORS_ORIGINS=["*"]
TIMEZONE=America/Lima

# --- Reglas de negocio ---
TAX_RATE=0.18
PRICES_INCLUDE_TAX=true
ALLOW_SELLING_EXPIRED=false
DEFAULT_RECEIPT_SERIES=B001

# --- Motor de alertas ---
ALERTS_EXPIRING_DAYS=15
ALERTS_INTERVAL_HOURS=6
ALERTS_SCHEDULER_ENABLED=true

